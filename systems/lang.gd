static func code() -> String:
	return "en" if str(Profile.get_s("lang")) == "en" else "ar"


static func t(key: String) -> String:
	var e = S.get(key)
	if e == null:
		return key
	return e[1] if code() == "en" else e[0]


static func digits(n: int) -> String:
	return str(n)
